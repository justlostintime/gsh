print "#{quote(application.name)}"
"#{'print'}" "evaluated"
$zqa = 4
for i as integer = 0 to 2
  echo the variables are {i} and $zqa
next
print `ls / > /dev/null`
print `ls /nofile 2> /dev/null`
echo /tmp > $zqd
ls -d {(Trim($zqd))}
vardel zqa
vardel zqd
$zqx = 1 :; $zqy = 2 :; print $zqx + $zqy
vardel zqx
vardel zqy
