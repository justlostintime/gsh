' Original Donut program by Andy Sloane
' https://www.a1k0n.net/2011/07/20/donut-math.html
' Gambas module file
Fast Unsafe

Public Sub donut()
''' Display a spinning ascii donut in the terminal
'' Press Ctrl-C to stop. The donut follows the terminal size when it is resized.
'' gsh sets system_break when Ctrl-C is pressed, the loop checks it after each frame.
'' No Catch or Finally here, they are not safe in Fast Unsafe (JIT) code.

  Dim theta_spacing As Float = 0.01
  Dim phi_spacing As Float = 0.01
  Dim TwoPi As Float = 6.28
  Dim R1 As Float = 1.00
  Dim R2 As Float = 2.00
  Dim K2 As Float = 5.0
  Dim Shader As Byte[] = Byte[].FromString(" .,-~:;=!*$#@")
  Dim ShadeMax As Integer = Shader.Max

  Dim screen_width, screen_height, iCols, iRows, stride As Integer
  Dim K1, halfW, halfH As Float
  Dim bOutput As Byte[]               ' (screen_width + 1) * screen_height, includes a newline per row
  Dim zBuffer As Float[]              ' screen_width * screen_height

  Dim a, b As Float
  Dim fFrameStart, fFrameTime, fRateStart, fElapsed, fFrameRate As Float
  Dim iFrames As Integer

  Dim cosA, sinA, cosB, sinB As Float
  Dim theta, phi As Float
  Dim costheta, sintheta, theta1, theta2, theta3, theta4, theta5, circlex, circley As Float
  Dim cosphi, sinphi, L, x, y, z, ooz As Float
  Dim xp, yp, iShade, j As Integer

  Print "\e[2J";
  fRateStart = Timer

  While Not system_break
    ' Read the terminal size and rebuild the buffers when it changes, the last row is the status line
    iCols = File.Out.Term.Width
    iRows = File.Out.Term.Height - 1
    If iCols < 2 Then iCols = 2
    If iRows < 2 Then iRows = 2
    If iCols <> screen_width Or If iRows <> screen_height Then
      screen_width = iCols
      screen_height = iRows
      stride = screen_width + 1
      halfW = screen_width / 2.00
      halfH = screen_height / 2.00
      ' K1 scales the projection to the screen width. Increase the divisor to
      ' make the donut smaller, decrease it to make it bigger.
      K1 = screen_width * K2 / (9.00 * (R1 + R2))
      bOutput = New Byte[stride * screen_height]
      zBuffer = New Float[screen_width * screen_height]
      Print "\e[2J";
    Endif

    fFrameStart = Timer

    cosA = Cos(a)
    sinA = Sin(a)
    cosB = Cos(b)
    sinB = Sin(b)

    ' Clear the buffers and put a newline at the end of every row
    bOutput.Fill(32)
    zBuffer.Fill(0)
    For j = 1 To screen_height
      bOutput[j * stride - 1] = 10
    Next

    For theta = 0.00 To TwoPi Step theta_spacing
      costheta = Cos(theta)
      sintheta = Sin(theta)
      theta1 = sinA * sintheta
      theta2 = costheta * sinB
      theta3 = cosA * costheta
      theta4 = cosA * sintheta
      theta5 = costheta * sinA
      circlex = R2 + (R1 * costheta)
      circley = R1 * sintheta

      For phi = 0.00 To TwoPi Step phi_spacing
        cosphi = Cos(phi)
        sinphi = Sin(phi)

        ' Luminance, ranges from -sqrt(2) to +sqrt(2). If it's <= 0 the surface
        ' is pointing away from us, so we won't bother trying to plot it.
        L = (cosphi * theta2) - (theta3 * sinphi) - theta1 + (cosB * (theta4 - (theta5 * sinphi)))
        If L <= 0 Then Continue

        x = circlex * (cosB * cosphi + sinA * sinB * sinphi) - (circley * cosA * sinB)
        y = circlex * (sinB * cosphi - sinA * cosB * sinphi) + (circley * cosA * cosB)
        z = K2 + cosA * circlex * sinphi + circley * sinA
        ooz = 1.00 / z

        ' x and y projection. y is negated because y goes up in 3D space
        ' but down on 2D displays.
        xp = CInt(halfW + K1 * ooz * x)
        yp = CInt(halfH - K1 * ooz * y)

        ' Skip points that fall off screen (Unsafe: no array bounds checking here)
        If xp < 0 Or If xp >= screen_width Then Continue
        If yp < 0 Or If yp >= screen_height Then Continue

        If ooz > zBuffer[yp * screen_width + xp] Then
          zBuffer[yp * screen_width + xp] = ooz
          iShade = 1 + CInt(L * 8)
          If iShade > ShadeMax Then iShade = ShadeMax
          bOutput[yp * stride + xp] = Shader[iShade]
        Endif
      Next
    Next

    ' Home the cursor and print the whole frame at once. The last byte of the
    ' buffer is a newline, which moves us to the status line.
    Print "\e[H"; bOutput.ToString();

    fFrameTime = Timer - fFrameStart
    a += 0.07
    b += 0.03

    Inc iFrames
    fElapsed = Timer - fRateStart
    If fElapsed >= 1.0 Then
      fFrameRate = iFrames / fElapsed
      iFrames = 0
      fRateStart = Timer
    Endif

    Print Format(fFrameTime, "0.0000"); "s  "; Format(fFrameRate, "0.0"); " fps\e[K";
    Flush

    Wait 0                                ' lets the Ctrl-C signal in, it sets system_break
  Wend

  Print "\e[2J\e[H";
  Flush

End
