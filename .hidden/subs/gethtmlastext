
Class Htmltotext

Public Sub GetHtmlAsText(TheUrl As String) As String[]
''' Fetch an html web  page and return it as a formatted text string
'' Read a web page and return the page converted to text
'' the page is converted with the gb.xml.html component, html2text is not needed
  Use "gb.net.curl"
  Dim sSource As New HttpClient
  Dim buffer As String
  Dim aTmps As New String[]

  sSource.url = TheUrl
  sSource.async = False
  sSource.timeout = 5
  Try sSource.Get
  If Error Or If sSource.status < 0 Then Return aTmps
  If Lof(sSource) Then
     buffer = Read #sSource, Lof(sSource)
  Else
    buffer = ""
  Endif

  If buffer <> "" And If Not (buffer Like "*This page does not exist*") Then
      atmps = Split(HtmlToText(buffer, 200), "\n", "", True)   ' the htmltotext sub converts the page
  Endif

  Return atmps
End

