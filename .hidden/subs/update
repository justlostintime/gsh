Sub update() As Boolean
''' After a new gsh version or a new profile.gsh is installed, load them
''update
''     clears the cached subs, classes and structs so the installed ones are compiled again,
''     prompting to save changed user subs, loads a new profile.gsh if there is one,
''     then gsh restarts itself in the same terminal

dim bNewProfile as boolean = exist(user.home &/ "vars/profile.gsh.new")
dim bNewVersion as boolean = sharedmem["subsversion"] <> sharedmem["gshversion"]
if not bNewProfile and not bNewVersion then
 error "Nothing to do"
 return false
endif

print "Update gsh";;sharedmem["gshversion"]
print "Clearing all in memory subs/classes/structs, prompting to save user subs"
print "gsh then restarts itself for the changes to take effect"
print "Other running shells must be exited before running this update."
error "Run update now Y/n?";
dim answer as string = ""
line input answer
answer = upper(trim(answer))

if answer = "" or if answer[0] = "Y" then

   clearclass()
   clearsubs()

   if not sharedmem!GshVarConverted then
       UpdateVarNames()       ' remove/rename all old style variables
       sharedmem!GshVarConverted = true
   endif

   if bNewProfile then
      if exist(user.home &/ "vars/profile.gsh.old") then
         kill user.home &/ "vars/profile.gsh.old"
      endif
      move user.home &/ "vars/profile.gsh" to user.home &/ "vars/profile.gsh.old"
      move user.home &/ "vars/profile.gsh.new" to user.home &/ "vars/profile.gsh"
   endif

   sharedmem["subsversion"] = sharedmem["gshversion"]

   dim cGsh as class = classes["gsh"]
   sharedmem["profile"] = false
   object.call(cGsh,"runfromextern",["profile.gsh"])
   object.call(cGsh,"RestartNow")

else
  error "Update: Update Cancelled"
  return false
endif

end
class sharedmem
class mem