Public Sub HtmlToText(sHtml As String, Optional Width As Integer = 80) As String
''' Convert an html page to plain text
'' Headings become "**** Title ****" lines, list items "    * item", code blocks keep their lines,
'' other text is wrapped at Width columns. Used by the Gambas help in place of the html2text program.
  Use "gb.xml.html"
  Dim hDoc As New HtmlDocument
  Dim aLines As New String[]
  Dim sLine As String

  sOutText = ""
  hDoc.HtmlFromString(sHtml)
  Walk(hDoc.Root)

  For Each sLine In Split(sOutText, "\n")
    If Left(sLine, 1) = "\x01" Then                          ' code block line, kept as it is
      aLines.Add(RTrim(Mid(sLine, 2)))
    Else
      sLine = Trim(Replace(Replace(sLine, "\t", " "), "\xc2\xa0", " "))
      While InStr(sLine, "  ")
        sLine = Replace(sLine, "  ", " ")
      Wend
      If Left(sLine, 2) = "* " Then sLine = "    " & sLine   ' list item
      If sLine <> "" Then aLines.Insert(Wrap(sLine, Width))
    Endif
  Next

  Return aLines.Join("\n") & "\n"

End

Private sOutText As String

Private Sub Walk(hNode As XmlNode)

  Dim hChild As XmlNode
  Dim sCode As String

  If hNode.IsText Then
    sOutText &= Decode(Replace(hNode.Value, "\n", " "))
    Return
  Endif
  If Not hNode.IsElement Then Return

  Select Case LCase(hNode.Name)
    Case "script", "style", "head", "noscript"
      Return
    Case "h1", "h2", "h3", "h4", "h5", "h6"
      sOutText &= "\n**** " & Trim(Decode(Replace(hNode.TextContent, "\n", " "))) & " ****\n"
      Return
    Case "br"
      sOutText &= "\n"
    Case "li"
      sOutText &= "\n* "
    Case "pre"
      sCode = CodeText(hNode, True)
    Case "div"
      If InStr(" " & XmlElement(hNode).GetAttribute("class") & " ", " code ") Then sCode = CodeText(hNode, False)   ' Gambas wiki code examples
  End Select
  If sCode Then
    sOutText &= "\n\x01" & Replace(Replace(sCode, "\xc2\xa0", " "), "\n", "\n\x01") & "\n"
    Return
  Endif

  For Each hChild In hNode.Children
    Walk(hChild)
  Next

  Select Case LCase(hNode.Name)
    Case "p", "div", "tr", "table", "ul", "ol", "dl", "dt", "dd", "blockquote"
      sOutText &= "\n"
  End Select

End

' The text of a code block, its lines come from <br> or, in <pre>, from the line ends
Private Sub CodeText(hNode As XmlNode, bPre As Boolean) As String

  Dim hChild As XmlNode
  Dim sText As String

  If hNode.IsText Then Return Decode(IIf(bPre, hNode.Value, Replace(hNode.Value, "\n", "")))
  If Not hNode.IsElement Then Return ""
  If LCase(hNode.Name) = "br" Then Return "\n"
  For Each hChild In hNode.Children
    sText &= CodeText(hChild, bPre)
  Next
  Return sText

End

' Replaces the HTML character references, the parser leaves them in the text
Private Sub Decode(sText As String) As String

  Dim iPos, iEnd, iCode As Integer
  Dim sName, sChar As String

  iPos = InStr(sText, "&")
  While iPos
    iEnd = InStr(sText, ";", iPos)
    If iEnd = 0 Or If iEnd - iPos > 10 Then
      iPos = InStr(sText, "&", iPos + 1)
      Continue
    Endif
    sName = Mid(sText, iPos + 1, iEnd - iPos - 1)
    Select Case sName
      Case "nbsp"
        sChar = " "
      Case "quot"
        sChar = "\""
      Case "apos"
        sChar = "'"
      Case "lt"
        sChar = "<"
      Case "gt"
        sChar = ">"
      Case "amp"
        sChar = "&"
      Case Else
        iCode = -1
        If sName Begins "#x" Or If sName Begins "#X" Then
          Try iCode = Val("&H" & Mid(sName, 3))
        Else If sName Begins "#" Then
          Try iCode = CInt(Mid(sName, 2))
        Endif
        If iCode <= 0 Then                               ' unknown name, left as it is, the next & may start one
          iPos = InStr(sText, "&", iPos + 1)
          Continue
        Endif
        sChar = String.Chr(iCode)
    End Select
    sText = Left(sText, iPos - 1) & sChar & Mid(sText, iEnd + 1)
    iPos = InStr(sText, "&", iPos + Len(sChar))
  Wend
  Return sText

End

' Splits a line into lines of at most iWidth characters at spaces, list items keep their indent
Private Sub Wrap(sLine As String, iWidth As Integer) As String[]

  Dim aResult As New String[]
  Dim sIndent As String = IIf(Left(sLine, 6) = "    * ", "      ", "")
  Dim iPos As Integer

  While String.Len(sLine) > iWidth
    iPos = String.RInStr(String.Left(sLine, iWidth + 1), " ")
    If iPos <= String.Len(sIndent) Then iPos = String.InStr(sLine, " ", String.Len(sIndent) + 2)   ' a word longer than the width
    If iPos = 0 Then Break
    aResult.Add(RTrim(String.Left(sLine, iPos - 1)))
    sLine = sIndent & LTrim(String.Mid(sLine, iPos + 1))
  Wend
  aResult.Add(sLine)
  Return aResult

End
