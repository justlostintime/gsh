' Gambas class file

Fast Unsafe
Class Sharedmem

'These are the defaults
' Static Public syms As String[]
' Static Public types As Integer[]
' Static Public seperators As String[] = [" ", "\n"]
' Static Public operators As String[] = ["::", "&&", "||", "(", ")"]
' Static Public SpecialSymbols As String[] = ["{", "}"]
' Static Public quotes As String[] = ["\"", "\""]
' Static Public braces As String[] = ["{", "}"]

Static defaultp As New ParseParm(True)
' the words after which a sub name is a call (command, pipe stage, redirect, substitution)
Static VarRunPositions As String[] = ["!", "|", "&|", "&&", "||", ":;"]   ' where @name runs a global variable as a command
Static SubPositions As String[] =["!", "|", "|>", "|<", "&|", "&|>", "&|<", ">", ">>", "&>", "&>>", "2>", "2>>", "<", "<<<", "{"]

Static Private Sub SymsInsert(p As ParseParm, sym As String, type As Integer)

    sym = Trim(sym)
    If sym = "" Then
        Return
    Endif

    If p.DoFileExpand = True Then
        FileExpandInsert(p, sym, type)
    Else
        p.syms.Add(sym)
        p.types.Add(type)
    Endif

End

'' process the input line and split it into seperate commands
Fast Unsafe Static Public Sub _call(InLine As String, Optional p As Parseparm = Null, IncludeBreak As Boolean = False, BreakOnEscape As Boolean = True) As String[]

    Dim CurrentType As Integer = Highlight.Symbol
    Dim streamPos As Integer = 0
    Dim sym As String = ""
    Dim OutputList As New String[]
    Dim QuoteLevel As Integer = 0
    Dim OpenQuote As String
    Dim i As Integer

    If inline = "" Then Return OutputList

    If IsNull(p) Then p = Defaultp

    InLine = Trim(InLine)

    p.syms = New String[]
    p.types = New Integer[]

    Do

        If p.seperators.Exist(InLine[streampos]) Then
            If sym.len > 0 Then
                SymsInsert(p, sym, CurrentType)
                sym = ""
                CurrentType = Highlight.Symbol
            Endif
            Inc streampos
            Continue
        Endif

        If p.SpecialSymbols.Exist(InLine[streampos]) And If p.DoSpecial Then
            If CurrentType <> Highlight.added And If sym.len > 0 Then
                SymsInsert(p, sym, CurrentType)
            Endif
            SymsInsert(p, InLine[streampos], Highlight.added)
            sym = ""
            CurrentType = Highlight.Symbol
            Inc StreamPos
            Continue
        Endif

        If p.braces.Exist(InLine[streampos]) Then
            If sym.len > 0 Then
                SymsInsert(p, sym, CurrentType)
            Endif
            SymsInsert(p, InLine[streampos], highlight.operator)
            sym = ""
            CurrentType = highlight.symbol
            Inc StreamPos
            Continue
        Endif

        ' a ( straight after a word is a function call, zqds("a"), not a ( ) group: keep it with the word up to the matching )
        If InLine[streampos] = "(" And If sym.len > 0 And If CurrentType <> Highlight.Operator And If p.operators.Exist("(") Then
            If IsLetter(Right(sym)) Or IsDigit(Right(sym)) Or Right(sym) = "_" Then
                Dim iCallDepth As Integer = 0
                Dim bCallString As Boolean = False
                While streampos < InLine.len
                    sym &= InLine[streampos]
                    If bCallString Then
                        If InLine[streampos] = "\\" And If streampos + 1 < InLine.len Then
                            Inc streampos
                            sym &= InLine[streampos]
                        Else If InLine[streampos] = "\"" Then
                            bCallString = False
                        Endif
                    Else If InLine[streampos] = "\"" Then
                        bCallString = True
                    Else If InLine[streampos] = "(" Then
                        Inc iCallDepth
                    Else If InLine[streampos] = ")" Then
                        Dec iCallDepth
                        If iCallDepth = 0 Then
                            Inc streampos
                            Break
                        Endif
                    Endif
                    Inc streampos
                Wend
                Continue
            Endif
        Endif

        If p.operators.Exist(InLine[streampos]) Then
            If CurrentType <> Highlight.operator Then
                If sym.len > 0 Then
                    SymsInsert(p, sym, CurrentType)
                    sym = ""
                    Currenttype = Highlight.operator
                    sym &= InLine[streampos]
                    Inc StreamPos
                    Continue
                Else
                    CurrentType = Highlight.Operator
                Endif
            Else
                If Not p.operators.Exist(sym & InLine[StreamPos]) Then
                    SymsInsert(p, sym, CurrentType)
                    sym = InLine[streampos]
                    Inc streampos
                    Continue
                Else
                    sym &= InLine[StreamPos]
                    Inc streampos
                    Continue
                Endif
            Endif
        Else If streampos + 1 < InLine.len And If p.operators.Exist(InLine[StreamPos] & InLine[StreamPos + 1]) And If Not (sym.len > 0 And IsDigit(InLine[StreamPos])) Then ' look ahead, limit 2, 2> only at the start of a word
            If CurrentType <> Highlight.operator Then
                If sym.len > 0 Then
                    SymsInsert(p, sym, CurrentType)
                    sym = ""
                Endif
                CurrentType = Highlight.Operator
                sym &= InLine[StreamPos] & InLine[StreamPos + 1]
                StreamPos += 2
            Else
                If Not p.operators.Exist(sym & InLine[StreamPos] & InLine[StreamPos + 1]) Then
                    SymsInsert(p, sym, CurrentType)
                    sym = InLine[streampos] & InLine[streampos + 1]
                    streampos += 2
                    Continue
                Else
                    sym &= InLine[StreamPos] & InLine[streampos + 1]
                    streampos += 2
                    Continue
                Endif
            Endif
        Endif

        ' a ' straight after a letter or digit (it's) does not start a ' quote, so a :; after it still splits the line
        Dim bApostrophe As Boolean = False
        If InLine[streampos] = "'" And If streampos > 0 Then bApostrophe = IsLetter(InLine[streampos - 1]) Or IsDigit(InLine[streampos - 1])
        If p.quotes.Exist(InLine[streampos]) And If Not bApostrophe Then  ' check for a quote character
            If BreakOnEscape And If sym.len > 0 Then
                SymsInsert(p, sym, CurrentType)
                sym = ""
            Endif

            If BreakOnEscape Then CurrentType = Highlight.string

            Dim currentquote As String = InLine[StreamPos]
            Dim inquote As Integer = p.quotes.Find(currentquote)
            OpenQuote = currentquote
            Inc inquote

            If inquote > p.quotes.max Or If inquote Mod 2 <> 1 Then
                Error.Raise("Invalid quote character \"" & currentquote & "\"\n" & Quote(inLine) & "\n")
            Endif

            currentquote = p.quotes[inquote]
            If Currentquote <> OpenQuote Then Inc QuoteLevel
            If p.KeepQuote Then sym &= InLine[StreamPos]
            Inc Streampos

            While StreamPos < InLine.len

                If InLine[StreamPos] = "\n" Then      ' end of line is as good as a close quote"
                    If p.allowEolToClose Then        ' this gets used for comment character ate end of line
                        sym &= InLine[StreamPos]
                        Inc StreamPos
                        Break
                    Else
                        Error.raise("Unmatched Quote Found End Of Line [" & currentquote & " ] in :" & Quote(inline))
                    Endif
                Endif

                ' inside ( ) a "..." string is copied whole, a ( or ) in it does not count
                If OpenQuote = "(" And If InLine[StreamPos] = "\"" Then
                    sym &= InLine[StreamPos]
                    Inc StreamPos
                    While StreamPos < InLine.len
                        sym &= InLine[StreamPos]
                        If InLine[StreamPos] = "\\" And If StreamPos + 1 < InLine.len Then
                            Inc StreamPos
                            sym &= InLine[StreamPos]
                        Else If InLine[StreamPos] = "\"" Then
                            Break
                        Endif
                        Inc StreamPos
                    Wend
                    Inc StreamPos
                    If StreamPos >= InLine.len Then
                        If p.allowEolToClose Then Break
                        Error.raise("Unmatched Quote at eol [" & currentquote & "]  in :" & Quote(inline))
                    Endif
                    Continue
                Endif

                If InLine[StreamPos] = OpenQuote And If OpenQuote <> CurrentQuote Then
                    Inc QuoteLevel
                Endif

                ' inside a '...' quote a ' followed by a letter or digit (it's) is text, not the closing quote
                Dim bInnerApostrophe As Boolean = False
                If currentquote = "'" And If InLine[StreamPos] = "'" And If StreamPos + 1 < InLine.len Then bInnerApostrophe = IsLetter(InLine[StreamPos + 1]) Or IsDigit(InLine[StreamPos + 1])
                If InLine[StreamPos] = currentquote And If Not bInnerApostrophe Then
                    If OpenQuote <> currentquote Then
                        Dec QuoteLevel
                        If QuoteLevel = 0 Then
                            If p.KeepQuote Then sym &= InLine[StreamPos]
                            Inc StreamPos
                            Break
                        Else
                            sym &= InLine[StreamPos]
                        Endif
                    Else
                        If p.KeepQuote Then sym &= InLine[StreamPos]
                        Inc StreamPos
                        Break
                    Endif
                Else
                    sym &= InLine[StreamPos]
                Endif

                If InLine[StreamPos] = "\\" Then
                    Inc StreamPos
                    If streampos < inline.len Then
                        sym &= InLine[StreamPos]
                    Else
                        Error.raise("Unmatched Quote at escape char [" & currentquote & "]  in :" & Quote(inline))
                    Endif
                Endif

                Inc StreamPos

                If streampos >= InLine.len Then
                    If p.allowEolToClose Then Break     ' a ' comment runs to the end of the line
                    Error.raise("Unmatched Quote at eol [" & currentquote & "]  in :" & Quote(inline))
                Endif

            Wend

            If BreakOnEscape Then
                SymsInsert(p, sym, CurrentType)
                sym = ""
                CurrentType = Highlight.symbol
            Endif
            Continue
        Endif

        If p.endofline.Exist(InLine[StreamPos]) Or If p.comments.Exist(InLine[StreamPos]) Then Break

        If CurrentType = Highlight.Operator Then
            If Not p.operators.Exist(sym & InLine[StreamPos]) Then
                SymsInsert(p, sym, CurrentType)
                sym = ""
                CurrentType = Highlight.symbol
            Endif
        Endif

        sym &= InLine[StreamPos]
        Inc StreamPos

    Loop Until StreamPos >= InLine.Len

    If sym.len > 0 Then
        SymsInsert(p, sym, CurrentType)
    Endif

    CheckBraces(p)
    'find a way to make {} a special set

    If p.DoSpecial = True Then
        'Divide the sets into single command lines
        Dim CurrentLine As Integer = 0
        Dim LastSegmentStart As Integer = 0
        Dim InSpecialSet As Integer = 0
        i = 0
        Do
            If i >= p.syms.count Then Break
            If p.types[i] = Highlight.added
                If p.SpecialSymbols.Find(p.syms[i]) % 2 = 0 Then
                    Inc InSpecialSet
                Else
                    Dec InSpecialSet
                Endif
            Endif
            If inSpecialSet = 0 Then
                If p.types[i] = Highlight.operator Then
                    If lastSegmentStart < i Then
                        OutputList.Add(p.syms.Copy(lastSegmentStart, i - lastSegmentStart).Join(" "))
                    Endif
                    LastSegmentStart = i + 1
                    Inc CurrentLine
                Endif

                If IncludeBreak Then
                    If p.types[i] = Highlight.operator Then
                        OutputList.Add(p.syms[i])
                    Endif
                Endif
            Endif
            Inc i
        Loop

        If LastSegmentStart <= p.syms.max Then
            OutputList.Add(p.syms.copy(lastSegmentStart, i - LastSegmentStart).Join(" "))
        Endif

        Return OutputList

    Else
        SpecialVariables(p.syms, p.types)

        For i = 0 To p.syms.Max
            ' a global variable is only run as a command when written @name, as the command or a pipe stage
            ' a bare name never matches a variable, so $mv = "x" does not hide /usr/bin/mv
            If Len(p.syms[i]) > 1 And If p.syms[i] Begins "@" Then
                ' an unknown @name is left as it is and reported later as Command Not Found
                Dim bVarPos As Boolean = (i = 0)
                If i > 0 Then bVarPos = VarRunPositions.Exist(p.syms[i - 1])
                If bVarPos And If sharedmem.exist(Mid(p.syms[i], 2)) Then
                    p.syms[i] = Mid(p.syms[i], 2)
                    p.types[i] = Highlight.Label             ' label = execute var as command
                    Continue
                Endif
            Endif
            If p.types[i] = Highlight.Symbol Then
                ' a sub is only looked up where one can be used: the command, a pipe stage, a redirect
                ' or a {...} substitution, so an ordinary argument such as echo toupper stays a plain word
                Dim bSubPos As Boolean = (i = 0)
                If i > 0 Then bSubPos = SubPositions.Exist(p.syms[i - 1])
                If bSubPos And If gsh.isLocalFunc(p.syms[i]) Then
                    p.types[i] = Highlight.Function          ' if it is a function it must be defined to at minimum output a string or to input a string or both
                Endif
            Endif
        Next

        Return p.syms
    Endif

Catch
    Error.Propagate()

End

Static Public Sub CheckBraces(p As ParseParm, Optional start As Integer = 0, matching As String = "") As Integer

    Dim index As Integer = start
    Dim braceindex As Integer

    If p.syms.count = 0 Then Return 0

    While index < p.syms.count
        If p.syms[index].len > 1 Or If p.syms[index] = "" Then
            Inc index
            Continue
        Endif
        braceindex = p.braces.Find(p.syms[index])
        If braceindex > -1 Then
            If braceindex % 2 = 0 Then ' have an opening brace
                Inc index
                index = CheckBraces(p, index, p.braces[braceindex + 1])
            Else If braceindex % 2 = 1 And If matching <> p.braces[braceindex] Then
                Error.Raise("Missing/mismatched Bracket/brace [ " & Quote(IIf(matching <> "", matching, p.braces[p.braces.Find(p.syms[index]) - 1])) & " ] in " & p.syms.Join(" "))
            Else
                Return index
            Endif
        Endif
        Inc index
    Wend
    If matching = "" Then
        Return 0
    Else
        Error.Raise("Missing closing Bracket/brace [ " & Quote(matching) & "  ] in " & p.syms.Join(" "))
    Endif

End

Static Private Sub FileExpandInsert(p As ParseParm, var As String, type As Integer) As Boolean ' return true if we expanded the value

    If type = Highlight.string Then
        p.syms.Add(var)
        p.types.Add(type)
        Return True
    Endif

    If Not CreateCmdProgram.IsGlob(var) Then
        p.syms.Add(var)
        p.types.Add(type)
        Return False
    Endif

    ' The command position is the first word or the first word after a pipe
    If p.syms.count = 0 Or If ["|", "!", "|>", "|<"].Exist(p.syms.Last) Then          'this is the command to execute
        Dim files As String[]
        files = CreateCmdProgram.DoGlob(var)
        If Files.count = 1 And If files[0] = var Then
            p.syms.Add(Files[0])
            p.types.Add(Highlight.added)
            Return False
        Else If Files.count > 1 Then
            ' Must stop here, returning without adding the command would make the next word the command
            Error.Raise("Too many matches for command " & Quote(var) & " -> " & files.Join(", "))
        Else
            p.syms.Add(Files[0])
            p.types.Add(Highlight.symbol)
        Endif
    Else
        p.syms.add("(")
        p.types.Add(Highlight.Operator)
        p.syms.Add("fileexpand(" & Quote(IIf(var Begins "@", Mid$(var, 2), var)) & ")")   ' @name forces a file name, drop the @
        p.types.Add(Highlight.custom)
        p.syms.add(")")
        p.types.Add(Highlight.Operator)
    Endif
    Return True

Catch
    Error.Propagate()

End

Static Public Sub SpecialVariables(syms As String[], types As Integer[]) ' replaces items in sline with Special functions

    Dim newSyms As New String[]
    Dim newTypes As New Integer[]

    For i As Integer = 0 To syms.Max

        If syms[i] = "$" Or If syms[i][0] = "$" Then
            If i + 1 <= syms.max And If syms[i] = "$" And syms[i + 1] = "!" Then
                syms[i] = "$!"
                syms[i + 1] = ""
            Endif
            Select Case syms[i]
                Case "$*"
                    newsyms.Add("(iif(args.count > 1,args.all.extract(1,args.max).join(\" \"),\"\"))") 'gsh.cmdLineParameters.count
                Case "$#"
                    newsyms.Add("(args.count)") 'gsh.cmdLineParameters.count
                Case "$?"  ' exit status of the last CLI command, set after each command line completes
                    newsyms.Add("(IIf(SharedMem.Exist(\"laststatus\"), SharedMem[\"laststatus\"], 0))")
                Case "$$"  ' insert the curent pid
                    newsyms.Add(Application.id)
                Case "$!"
                    newsyms.Add("(Application.id)")
                Case "$UID"
                    newsyms.Add("(User.id)")
                Case "$GID"
                    newsyms.Add("(User.group)")
                Default
                    If IsNumber(Right(syms[i], -1)) Then
                        Dim argindex As Integer = Right(syms[i], -1)
                        newsyms.Add("(IIf (" & argindex & " > Args.max, \"\", Args[" & argindex & "]))")
                    Else
                        newsyms.Add(syms[i])
                    Endif
            End Select
            newTypes.Add(types[i])
        Else
            If syms[i] <> "" Then
                newsyms.Add(syms[i])
                newTypes.Add(types[i])
            Endif
        Endif

    Next

    types.Clear
    types.Insert(newTypes)
    syms.Clear
    syms.insert(newsyms)

End
