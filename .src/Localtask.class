' Gambas class file

Inherits Task
' a good task
Class SharedMem

Public Parms As Variant[]
Public Method As String
Public sObject As String

Public Sub _new(mObject As String, sMethod As String, vParms As Variant[])

    Parms = vParms
    Method = SMethod
    sObject = mObject

End

Public Sub main()

    If gsh.dotrace Then
        Print "Start bg task with";; Method, sObject
        Flush
        Wait
    Endif

    gsh.LocalRunning = True
    Try Object.Call(SubCls[sObject], method, parms)
    If Error Then
        Dim sErrText As String = Error.Text                 ' FlushOutput resets Error
        Dim sErrWhere As String = Error.Where
        gsh.LocalRunning = False
        FlushOutput()
        If sErrText <> "Terminated" Then
            If gsh.DoTrace Then
                Error (("Local Execute error in :") & Method & sErrWhere & " @line(" & Split(sErrWhere, ".")[2] & ") [" & sErrText & "]")
                SubCls.doListing(SharedMem["sub." & method], Split(sErrWhere, ".")[2])
            Endif
            Error.Raise(("gsh local execute error :") & Method & " @line(" & Split(sErrWhere, ".")[2] & ") [" & sErrText & "]")
        Else
            Error ("[Terminated]")
        Endif
    Endif

    If gsh.dotrace Then
        Print "call completed"
        Flush
        Wait
    Endif

    gsh.LocalRunning = False
    FlushOutput()

Catch
    Print "Local Task Error :";; Error.text;; Error.where
    FlushOutput()

End

' A task ends with _exit() and nothing flushes its output: when gsh writes to a pipe or a file
' (not a terminal) what the sub printed was lost
Private Sub FlushOutput()

    Try Flush
    Try Flush #File.Err

End
