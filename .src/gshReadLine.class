' Gambas class file

Export
Class SharedMem
Class GshReadLineVars

Extern rFree(Mem As Pointer) In "libc:6" Exec "free"
'Extern strncpy(dest As Pointer, src As String, len As Integer) As Pointer In "libc:6"

' Read line function must be imported
Extern rl_bind_key_in_map(mchar As Integer, func As Pointer, keymap As Pointer) In "libreadline"
Extern rl_get_keymap_by_name(mapname As String) As Pointer In "libreadline"
Extern rl_get_keymap() As Pointer In "libreadline"
Extern using_history() In "libreadline"
Extern readline(prompt As String) As Pointer In "libreadline"
Extern add_history(Item As String) In "libreadline"
Extern history_expand(Item As Pointer, Expansion As Pointer) As Integer In "libreadline"
Extern rl_initialize() In "libreadline"
Extern rl_resize_terminal() In "libreadline"
Extern rl_add_defun(entry As String, func As Pointer, parm As Integer) In "libreadline"
Extern rl_copy_text(iStart As Integer, iEnd As Integer) As Pointer In "libreadline"
Extern rl_bind_keyseq(seq As String, rl_command_func_t As Pointer) As Integer In "libreadline"
Extern rl_replace_line(new_buffer As String, start As Integer) In "libreadline"
Extern rl_delete_text(Start As Integer, end As Integer) In "libreadline"
Extern rl_redisplay() In "libreadline"
Extern rl_insert_text(text As String) As Integer In "libreadline"
Extern rl_forced_update_display() As Integer In "libreadline"
Extern rl_function_dumper(readable As Integer) In "libreadline"
' callback mode : the event loop runs while the prompt waits for a key
Extern rl_callback_handler_install(prompt As String, lhandler As Pointer) In "libreadline"
Extern rl_callback_read_char() In "libreadline"
Extern rl_callback_handler_remove() In "libreadline"
Extern rl_callback_sigcleanup() In "libreadline"
Extern rl_free_line_state() In "libreadline"
Extern rl_cleanup_after_signal() In "libreadline"
Extern rl_reset_after_signal() In "libreadline"
Extern rl_on_new_line() As Integer In "libreadline"
Extern rl_clear_visible_line() As Integer In "libreadline"
Extern rl_get_screen_size(pRows As Pointer, pCols As Pointer) In "libreadline"
Extern rl_variable_value(sName As String) As Pointer In "libreadline"

Public DoTrace As Boolean
Public DefaultPrompt As String
Public UserPrompt As String
Public Queue As New String[]

Property Read isTerminal As Boolean Use $isTerminal
Property Read AtPrompt As Boolean Use $AtPrompt     '' True while ReadTerminal waits for the line
Property Read LiveHighlight As Boolean Use $bLive    '' True when the line being read is highlighted as it is typed
Property Read LineWasLive As Boolean Use $bLineLive  '' True when the last line read was shown highlighted as it was typed

' Live highlighting : readline's rl_redisplay_function is replaced by HighlightRedisplay
Private $pRedisplayVar As Pointer           ' address of rl_redisplay_function
Private $pRedisplayDefault As Pointer       ' rl_redisplay, readline's own function
Private $pRedisplayHook As Pointer          ' HighlightRedisplay as a C callback
Private $pLastCPos As Pointer               ' _rl_last_c_pos, the screen column of the cursor
Private $pLastVPos As Pointer               ' _rl_last_v_pos, the row of the cursor below the prompt row
Private $iPromptWidth As Integer            ' columns of the last line of the prompt
Private $iPromptBytes As Integer            ' bytes of the last line of the prompt, without the escape sequences
Private $bHScroll As Boolean                ' horizontal-scroll-mode : the line is scrolled sideways, not wrapped

Private $pLine As Pointer                  ' the line given to LineHandler, freed by the caller
Private $bLineDone As Boolean
Property rl_var As Rlvars Use $rl_var

Public Sub _new(Optional sUserPrompt As String = Quote("$"), sDefaultPrompt As String = Quote("$"))

    DoTrace = False
    $rl_var = New Rlvars
    SetVEdit()
    DefaultPrompt = sDefaultPrompt
    UserPrompt = sUserPrompt
    $isTerminal = File.In.IsTerm

End

Public Sub Trace(onoff As Boolean)

    DoTrace = onoff

End


Public Sub RewriteLineHighlighted(text As String, Optional NoHighlight As Boolean = False)

    If Not $isTerminal Then Return

    gsh.ConsoleHighlight.CanRewrite = True
    Print "\e[1F\e[2K";                        ' reposition the cursor to begining of the line
    Flush
    WritePrompt(gsh.SetBlockIndent())
    If NoHighlight Then
        Print text;
    Else
        Print gsh.ConsoleHighlight.ToANSI(text);
    Endif

End

Public Sub WritePrompt(BlockIndent As String)

    Dim Prompt As String
    Dim retryloop As Integer = 2

    If Not $isTerminal Then Return

retryprompt:
    Wait 0
    If DoTrace Then Error ("Trying to read from terminal")
    If retryloop = 0 Then
        Error ("Unable to evaluate any prompt type using ' $ '")
        prompt = " $ "
    Else

        'Debug Line * * * *
        'Print "starting "; Eval("CDate(Now) & \" > \"");; Eval(tprompt);; Eval(userprompt);; " try prompt "

        Try prompt = Eval(userprompt)
        If Error Then
            userprompt = DefaultPrompt
            Dec retryloop
            Goto retryprompt
        Endif
    Endif

    Print prompt; BlockIndent;
    Flush

End

Public Sub gsh_add_history(text As String)

    Try using_history()
    add_history(text)

End

'' One line of a here document, as typed: no trim, no history expansion, not added to history
'' RawEof is set at the end of the input
Public RawEof As Boolean = False

Public Sub ReadRaw(Optional sPrompt As String = "> ", bDbaseServer As Boolean = False) As String

    Dim pInput As Pointer
    Dim sInput As String = ""
    Dim rByte As Byte

    RawEof = False
    If bDbaseServer Then
        While True
            If Eof(File.In) Then
                RawEof = sInput = ""
                Break
            Endif
            Read #File.In, rByte
            If rByte = &H0A Then Break
            sInput &= Chr(rByte)
        Wend
    Else If Not $isTerminal Then
        If Eof(File.In) Then
            RawEof = True
        Else
            Line Input #File.In, sInput
        Endif
    Else
        pInput = ReadTerminal(sPrompt)
        If IsNull(pInput) Then
            RawEof = True
        Else
            sInput = String(1, String@(pInput))           ' copy it, String@ points into the memory freed next
            rFree(pInput)
        Endif
    Endif
    Return sInput

End

Public Sub _call(Optional BlockIndent As String = "", bDbaseServer As Boolean = False) As String

    Dim pInput As Pointer
    Dim sInput As String
    Dim Prompt As String

    If DoTrace Then Error ("Begin readline")

    'Debug Line * * * *
    'Dim tprompt As String = "cdate(now)"
    'Print "starting "; Eval("CDate(Now)");; Eval(tprompt);; " Readline _Call"

    If bDbaseServer Then
        If DoTrace Then Error ("Begin server mode reads")
        Dim rByte As Byte
        sInput = ""
        While True
            Read #file.in, rByte
            If rbyte = &H0A Then Break
            sInput &= Chr(rbyte)
        Wend
        sInput = Trim(sInput)
        If DoTrace Then Error "(Trace "; Now; ") ";; "Read line ="; sInput
    Else If Not $isTerminal Then
        If Not Eof(File.in) Then
            Line Input #File.in, sInput
        Else
            Return "QUIT"
        Endif
    Else
        Dim retryloop As Integer = 2
retryprompt:
        Wait 0
        If DoTrace Then Error ("Trying to read from terminal")
        If Queue.count = 0 Then
            If retryloop = 0 Then
                Error ("Unable to evaluate any prompt type using ' $ '")
                prompt = " $ "
            Else

                'Debug Line * * * *
                'Print "starting "; Eval("CDate(Now) & \" > \"");; Eval(tprompt);; Eval(userprompt);; " try prompt "

                Try prompt = Eval(userprompt)
                If Error Then
                    userprompt = DefaultPrompt
                    Dec retryloop
                    Goto retryprompt
                Endif
            Endif

            If DoTrace Then Error ("Reading From Readline Version");; $rl_var!rl_library_version
            ' SetBlockIndent()
            If gsh.BlockLevel = 0 Then    ' reach out to the gsh class to see what block level we are reading
                Print "\n";                 ' If it is evel 0 then print cr as to have beginning of line for the prompt
                Flush                       ' Make sure it is printed
            Endif
            pinput = ReadTerminal(Prompt & BlockIndent, True)
            $bLineLive = $bLive

            If Queue.count = 0 Then ' we did not used the edit function
                If IsNull(pinput) Then Return "QUIT"

                sInput = Trim(gsh_history_expand(pinput))

                If DoTrace Then Error "(Trace "; Now; ") ";; "Readline Input ="; String@(pinput)

                rFree(pInput)
            Endif
        Else
            $bLineLive = False
            sInput = Trim(gsh_history_expand(Queue.Pop()))
            Print sInput
        Endif

        If sInput <> "" Then
            gsh_add_history(sInput)
        Endif

        If DoTrace Then Error ("Readline Complete")
    Endif

    Wait 0

    Return sInput

Catch
    Error.Propagate()

End

'' Read a line like readline() : the returned pointer is freed by the caller, Null at end of input.
'' Uses the readline callback interface, so the Gambas event loop runs while the prompt waits :
'' process Kill events, timers and signals are handled at once, not after the next line.
Private Sub ReadTerminal(sPrompt As String, Optional bHighlight As Boolean) As Pointer

    $pLine = Null
    $bLineDone = False
    sPrompt = MarkInvisible(sPrompt)
    SetLiveHighlight(bHighlight And SharedMem["usehighlight"])
    If $bLive Then
        Dim sShown As String = RegExp.Replace(sPrompt, "\\x01[^\\x02]*\\x02", "")
        sShown = Mid(sShown, RInStr(sShown, "\n") + 1)
        $iPromptWidth = String.Len(sShown)
        $iPromptBytes = Len(sShown)
        Try $bHScroll = LCase(String@(rl_variable_value("horizontal-scroll-mode"))) = "on"
    Endif
    rl_callback_handler_install(sPrompt & "\x00", LineHandler)
    Object.Attach(File.In, Me, "StdIn")
    File.In.Watch(gb.Read, True)
    $AtPrompt = True
    While Not $bLineDone
        Wait Next
    Wend
    $AtPrompt = False
    File.In.Watch(gb.Read, False)
    Return $pLine

Catch                                       ' Break! from Ctrl-C in a block, passed on to DoBlock
    $AtPrompt = False
    File.In.Watch(gb.Read, False)
    rl_callback_handler_remove()
    Error.Propagate()

End

'' The prompt with each escape sequence between \001 and \002 : readline does not count them as columns.
'' Unmarked, readline counts the colour codes of the prompt as text, gets the wrapping of a long line
'' wrong and scrolls the line sideways when the codes are wider than the screen
Private Sub MarkInvisible(sPrompt As String) As String

    If InStr(sPrompt, "\x01") Then Return sPrompt       ' already marked
    If Not InStr(sPrompt, "\e") Then Return sPrompt
    Return RegExp.Replace(sPrompt, "(\\x1b(\\[[0-9;?]*[ -/]*[@-~]|\\][^\\x07\\x1b]*(\\x07|\\x1b\\\\)|[()][0-9A-Za-z]|[78=>]))", "\x01&1\x02")

End

'' Turn the live highlighting of the typed line on or off, readline draws the line itself when off
Private Sub SetLiveHighlight(bOn As Boolean)

    If bOn = $bLive Then Return
    If bOn Then
        If Not $pRedisplayVar Then
            $pRedisplayVar = System.GetExternSymbol("libreadline", "rl_redisplay_function")
            $pRedisplayDefault = System.GetExternSymbol("libreadline", "rl_redisplay")
            $pLastCPos = System.GetExternSymbol("libreadline", "_rl_last_c_pos")
            $pLastVPos = System.GetExternSymbol("libreadline", "_rl_last_v_pos")
            $pRedisplayHook = CPointer(HighlightRedisplay)
        Endif
        If Not ($pRedisplayVar And $pRedisplayDefault And $pLastCPos And $pLastVPos And $pRedisplayHook) Then Return
        Pointer@($pRedisplayVar) = $pRedisplayHook
    Else
        Pointer@($pRedisplayVar) = $pRedisplayDefault
    Endif
    $bLive = bOn

End

'' Readline's display function while live highlighting is on. Readline draws the line as usual, then the
'' part of the text on screen is printed again in colour over the same columns, between ESC 7 and ESC 8 :
'' the cursor and what readline knows of the screen do not change
Public Sub HighlightRedisplay()

    Dim sLine, sColour, sOut As String
    Dim iPoint, iCol, iRow, iRows, iWidth, iLen, iMargin, iFirst, iLast, iStart, iEdge, iTextBytes As Integer

    rl_redisplay()

    sLine = $rl_var!rl_line_buffer
    If Not sLine Then Return
    If RegExp.Match(sLine, "[\\x00-\\x1f\\x7f]") Then Return      ' readline shows control characters as ^X
    If RegExp.Match(sLine, "[\\x{1100}-\\x{10FFFF}]", RegExp.UTF8) Then Return   ' may be two columns wide, the columns are not known
    sColour = gsh.HighlightInput(sLine)
    If Not sColour Then Return

    iPoint = String.Len(Left(sLine, $rl_var!rl_point))
    iLen = String.Len(sLine)
    iCol = Integer@($pLastCPos)
    iRow = Integer@($pLastVPos)
    rl_get_screen_size(VarPtr(iRows), VarPtr(iWidth))
    If iWidth < 2 Then Return

    If $bHScroll Then
        ' readline shows a window of the prompt and text, a < in its first column when scrolled and a > in the
        ' last column used when more text follows. It places the > by bytes, not characters
        iTextBytes = Len(sLine)
        If iCol = $iPromptWidth + iPoint Then           ' not scrolled, the prompt is on screen
            iFirst = 0
            iStart = $iPromptWidth
            iEdge = iWidth - 1 - $iPromptBytes          ' text bytes before the >
        Else
            iMargin = iPoint - iCol                     ' the character under the <
            If iMargin < 0 Then Return
            iFirst = iMargin + 1
            iStart = 1
            iEdge = Len(String.Left(sLine, iMargin)) + iWidth - 1
        Endif
        iLast = IIf(iEdge < iTextBytes, CharsIn(Left(sLine, iEdge)), iLen)
        If iLast <= iFirst Then Return
        sOut = "\e7\r"
    Else
        ' the text starts after the prompt and wraps at the screen width
        iFirst = 0
        iLast = iLen
        iStart = $iPromptWidth Mod iWidth
        iRow -= $iPromptWidth \ iWidth
        sOut = "\e7" & IIf(iRow > 0, "\e[" & CStr(iRow) & "A", IIf(iRow < 0, "\e[" & CStr(-iRow) & "B", "")) & "\r"
    Endif
    If iStart > 0 Then sOut &= "\e[" & CStr(iStart) & "C"

    Print sOut; AnsiSlice(sColour, iFirst, iLast); "\e[0m\e8";
    Flush

Catch                                           ' never raise into readline, draw plain from now on
    Pointer@($pRedisplayVar) = $pRedisplayDefault
    $bLive = False

End

'' The number of characters in a text cut at any byte : the bytes that are not UTF-8 continuation bytes
Private Sub CharsIn(sText As String) As Integer

    Dim iCount As Integer

    For i As Integer = 1 To Len(sText)
        If (Asc(sText, i) And &HC0) <> &H80 Then Inc iCount
    Next
    Return iCount

End

'' The characters iFirst to iLast - 1 of a coloured text, with every escape sequence before iLast so the
'' colours are right
Private Sub AnsiSlice(sAnsi As String, iFirst As Integer, iLast As Integer) As String

    Dim sOut As String
    Dim i As Integer = 1
    Dim iChar As Integer = -1                  ' the character the current byte belongs to
    Dim iEnd, b As Integer

    While i <= Len(sAnsi)
        b = Asc(sAnsi, i)
        If b = 27 Then                          ' ESC [ digits ; ? and a final byte, or ESC and one byte
            iEnd = i + 1
            If Mid(sAnsi, iEnd, 1) = "[" Then
                Inc iEnd
                While iEnd <= Len(sAnsi) And InStr("0123456789;?", Mid(sAnsi, iEnd, 1))
                    Inc iEnd
                Wend
            Endif
            sOut &= Mid(sAnsi, i, iEnd - i + 1)
            i = iEnd + 1
            Continue
        Endif
        If (b And &HC0) <> &H80 Then            ' not a UTF-8 continuation byte : a new character
            Inc iChar
            If iChar >= iLast Then Break
        Endif
        If iChar >= iFirst Then sOut &= Chr(b)
        Inc i
    Wend

    Return sOut

End

Public Sub StdIn_Read()

    rl_callback_read_char()

End

'' Called by readline with the finished line, Null at end of input (Ctrl-D)
Public Sub LineHandler(pLine As Pointer)

    $pLine = pLine
    $bLineDone = True
    rl_callback_handler_remove()

End

'' Print a message, a job that ended, without mixing it into the line being typed : while the prompt waits
'' the prompt and the typed text are wiped, the message printed and they are drawn again below it,
'' with the cursor where it was. Otherwise it is printed as usual.
Public Sub Notify(sMsg As String, Optional bStdErr As Boolean = True)

    If Not $AtPrompt Then
        If bStdErr Then
            Error sMsg
        Else
            Print sMsg
        Endif
        Return
    Endif

    rl_clear_visible_line()                    ' the prompt and the typed text, also when wrapped
    Flush
    If bStdErr Then
        Error sMsg
    Else
        Print sMsg
        Flush
    Endif
    rl_on_new_line()
    rl_forced_update_display()

End

'' Ctrl-C at the prompt : drop the line being typed and show a new prompt
Public Sub CancelLine(Optional bNewPrompt As Boolean = True)

    rl_free_line_state()
    rl_callback_sigcleanup()
    rl_cleanup_after_signal()
    rl_reset_after_signal()
    $rl_var!rl_line_buffer = ""                ' writes the terminating 0 at the start of the buffer
    $rl_var!rl_point = 0
    $rl_var!rl_end = 0
    $rl_var!rl_mark = 0
    Print "^C"
    If Not bNewPrompt Then Return              ' the caller prints a message and reads the next line itself
    rl_on_new_line()
    rl_forced_update_display()

End

'' The window was resized while the prompt waits, readline only sees SIGWINCH between keys
Public Sub Resize()

    rl_resize_terminal()

End

Private Sub gsh_history_expand(data As Pointer) As String

    Dim pExpansion As Pointer = 0
    Dim Result As Integer = 0
    Dim NewData As String = Trim(String(1, String@(data)))

    If SharedMem["history_expand"] = False Then Return NewData

    Result = history_expand(data, VarPtr(pExpansion))

    If Result = 1 Or If Result = 0 Then
        NewData = String(1, String@(pExpansion))              ' do this to force a copy of the string to our data segment
        rFree(pExpansion)
    Endif

    Return NewData

Catch
    Error.Propagate()

End

Public Sub SetVEdit()

    Dim keymap As Pointer

    rl_initialize()

    keymap = rl_get_keymap_by_name("vi-command")
    If Not IsNull(keymap) Then
        rl_bind_key_in_map(Asc("v"), myedit, keymap)
    Endif

End

Public Sub myedit(count As Integer, key As Integer) As Integer

    Dim NewBuffer As String[]

    newBuffer = Split(readlineopenedit($rl_var!rl_line_buffer), "\n", "\"", True, True)

    rl_delete_text(0, $rl_var!rl_end)
    $Rl_var!rl_done = 1

    If NewBuffer.count > 1 Then
        For i As Integer = newBuffer.max DownTo 0
            Queue.Push(newBuffer[i])
        Next
    Endif

    Return 0

End

Public Sub readlineopenedit(text As String) As String

    Dim edit As String
    Dim filename As String = Temp("myedit")

    File.Save(filename, text)
    Try edit = Env["EDITOR"]
    If Error Or If edit = "" Then
        edit = "/usr/bin/vi"
    Endif
    Exec [edit, filename] Wait
    text = File.Load(filename)
    Return text

End
