' Gambas class file

Export
Class SharedMem
Class GshReadLineVars

Extern rFree(Mem As Pointer) In "libc:6" Exec "free"
Extern strncpy(dest As Pointer, src As String, len As Integer) As Pointer In "libc:6"

' Read line function must be imported
Extern rl_bind_key_in_map(mchar As Integer, func As Pointer, keymap As Pointer) In "libreadline"
Extern rl_get_keymap_by_name(mapname As String) As Pointer In "libreadline"
Extern rl_get_keymap() As Pointer In "libreadline"
Extern using_history() In "libreadline"
Extern readline(prompt As String) As Pointer In "libreadline"
Extern add_history(Item As String) In "libreadline:8"
Extern history_expand(Item As Pointer, Expansion As Pointer) As Integer In "libreadline"
Extern rl_initialize() In "libreadline"
Extern rl_resize_terminal() In "libreadline"
Extern rl_add_defun(entry As String, func As Pointer, parm As Integer) In "libreadline"
Extern rl_copy_text(iStart As Integer, iEnd As Integer) As Pointer In "libreadline"
Extern rl_bind_keyseq(seq As String, rl_command_func_t As Pointer) As Integer In "libreadline"
Extern rl_replace_line(new_buffer As String, start As Integer) In "libreadline"
Extern rl_delete_text(Start As Integer, end As Integer) In "libreadline"
Extern rl_redisplay() In "libreadline"
Extern rl_insert_text(text As String) As Integer In "libreadline"
Extern rl_forced_update_display() As Integer In "libreadline"
Extern rl_function_dumper(readable As Integer) In "libreadline"

Public DoTrace As Boolean
Public DefaultPrompt As String
Public UserPrompt As String
Public Queue As New String[]

Property Read isTerminal As Boolean Use $isTerminal
Property rl_var As Rlvars Use $rl_var

Public Sub _new(Optional sUserPrompt As String = Quote("$"), sDefaultPrompt As String = Quote("$"))

    DoTrace = False
    $rl_var = New Rlvars
    SetVEdit()
    DefaultPrompt = sDefaultPrompt
    UserPrompt = sUserPrompt
    $isTerminal = File.In.IsTerm

End

Public Sub Trace(onoff As Boolean)

    DoTrace = onoff

End


Public Sub RewriteLineHighlighted(text As String, Optional NoHighlight As Boolean = False)

    If Not $isTerminal Then Return

    gsh.ConsoleHighlight.CanRewrite = True
    Print "\e[1F\e[2K";                        ' reposition the cursor to begining of the line
    Flush
    WritePrompt(gsh.SetBlockIndent())
    If NoHighlight Then
        Print text;
    Else
        Print gsh.ConsoleHighlight.ToANSI(text);
    Endif

End

Public Sub WritePrompt(BlockIndent As String)

    Dim Prompt As String
    Dim retryloop As Integer = 2

    If Not $isTerminal Then Return

retryprompt:
    Wait 0
    If DoTrace Then Error ("Trying to read from terminal")
    If retryloop = 0 Then
        Error ("Unable to evaluate any prompt type using ' $ '")
        prompt = " $ "
    Else

        'Debug Line * * * *
        'Print "starting "; Eval("CDate(Now) & \" > \"");; Eval(tprompt);; Eval(userprompt);; " try prompt "

        Try prompt = Eval(userprompt)
        If Error Then
            userprompt = DefaultPrompt
            Dec retryloop
            Goto retryprompt
        Endif
    Endif

    Print prompt; BlockIndent;
    Flush

End

Public Sub gsh_add_history(text As String)

    Try using_history()
    add_history(text)

End




Public Sub _call(Optional BlockIndent As String = "", bDbaseServer As Boolean = False) As String

    Dim pInput As Pointer
    Dim sInput As String
    Dim Prompt As String

    If DoTrace Then Error ("Begin readline")

    'Debug Line * * * *
    'Dim tprompt As String = "cdate(now)"
    'Print "starting "; Eval("CDate(Now)");; Eval(tprompt);; " Readline _Call"

    If bDbaseServer Then
        If DoTrace Then Error ("Begin server mode reads")
        Dim rByte As Byte
        sInput = ""
        While True
            Read #file.in, rByte
            If rbyte = &H0A Then Break
            sInput &= Chr(rbyte)
        Wend
        sInput = Trim(sInput)
        If DoTrace Then Error "(Trace "; Now; ") ";; "Read line ="; sInput
    Else If Not $isTerminal Then
        If Not Eof(File.in) Then
            Line Input #File.in, sInput
        Else
            Return "QUIT"
        Endif
    Else
        Dim retryloop As Integer = 2
retryprompt:
        Wait 0
        If DoTrace Then Error ("Trying to read from terminal")
        If Queue.count = 0 Then
            If retryloop = 0 Then
                Error ("Unable to evaluate any prompt type using ' $ '")
                prompt = " $ "
            Else

                'Debug Line * * * *
                'Print "starting "; Eval("CDate(Now) & \" > \"");; Eval(tprompt);; Eval(userprompt);; " try prompt "

                Try prompt = Eval(userprompt)
                If Error Then
                    userprompt = DefaultPrompt
                    Dec retryloop
                    Goto retryprompt
                Endif
            Endif

            If DoTrace Then Error ("Reading From Readline Version");; $rl_var!rl_library_version
            ' SetBlockIndent()
            If gsh.BlockLevel = 0 Then    ' reach out to the gsh class to see what block level we are reading
                Print "\n";                 ' If it is evel 0 then print cr as to have beginning of line for the prompt
                Flush                       ' Make sure it is printed
            Endif
            pinput = readline(Prompt & BlockIndent & "\x00")

            If Queue.count = 0 Then ' we did not used the edit function
                If IsNull(pinput) Then Return "QUIT"

                sInput = Trim(gsh_history_expand(pinput))

                If DoTrace Then Error "(Trace "; Now; ") ";; "Readline Input ="; String@(pinput)

                rFree(pInput)
            Endif
        Else
            sInput = Trim(gsh_history_expand(Queue.Pop()))
            Print sInput
        Endif

        If sInput <> "" Then
            gsh_add_history(sInput)
        Endif

        If DoTrace Then Error ("Readline Complete")
    Endif

    Wait 0

    Return sInput

Catch
    Error.Propagate()

End

Private Sub gsh_history_expand(data As Pointer) As String

    Dim pExpansion As Pointer = 0
    Dim Result As Integer = 0
    Dim NewData As String = Trim(String(1, String@(data)))

    If SharedMem["history_expand"] = False Then Return NewData

    Result = history_expand(data, VarPtr(pExpansion))

    If Result = 1 Or If Result = 0 Then
        NewData = String(1, String@(pExpansion))              ' do this to force a copy of the string to our data segment
        rFree(pExpansion)
    Endif

    Return NewData

Catch
    Error.Propagate()

End

Public Sub SetVEdit()

    Dim keymap As Pointer

    rl_initialize()

    keymap = rl_get_keymap_by_name("vi-command")
    If Not IsNull(keymap) Then
        rl_bind_key_in_map(Asc("v"), myedit, keymap)
    Endif

End

Public Sub myedit(count As Integer, key As Integer) As Integer

    Debug "myedit ";; count;; key
    Dim NewBuffer As String[]

    newBuffer = Split(readlineopenedit($rl_var!rl_line_buffer), "\n", "\"", True, True)

    rl_delete_text(0, $rl_var!rl_end)
    $Rl_var!rl_done = 1

    If NewBuffer.count > 1 Then
        For i As Integer = newBuffer.max DownTo 0
            Queue.Push(newBuffer[i])
        Next
    Endif

    Return 0

End

Public Sub readlineopenedit(text As String) As String

    Dim edit As String
    Dim filename As String = Temp("myedit")

    File.Save(filename, text)
    Try edit = Env["EDITOR"]
    If Error Or If edit = "" Then
        edit = "/usr/bin/vi"
    Endif
    Exec [edit, filename] Wait
    text = File.Load(filename)
    Return text

End
